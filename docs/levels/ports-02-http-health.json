{
  "id": "ports-02-http-health",
  "sequence": "ports",
  "name": "Health Endpoint",
  "objective": "Make HTTP GET /health on api-01:8080 return 200 from client-01 (the service is marked unhealthy — fix the world so the goal passes).",
  "hint": "The service exists but healthy=false. Start a fresh healthy listener (docker run) or note that the goal needs /health → 200. In this lab, publish a healthy container on 8080.",
  "par": 1,
  "os_focus": ["linux", "windows"],
  "start": {
    "networks": { "lab": "10.0.0.0/24" },
    "hosts": {
      "client-01": {
        "os": "windows",
        "role": "client",
        "interfaces": {
          "Ethernet0": { "network": "lab", "ip": "10.0.0.30", "prefix": 24, "state": "up" }
        },
        "default_gateway": "10.0.0.1",
        "firewall_enabled": false
      },
      "api-01": {
        "os": "linux",
        "role": "api",
        "interfaces": {
          "eth0": { "network": "lab", "ip": "10.0.0.10", "prefix": 24, "state": "up" }
        },
        "firewall_enabled": false,
        "services": {
          "8080": { "proto": "tcp", "name": "http", "banner": "api v1", "healthy": false }
        }
      }
    }
  },
  "goal_checks": [
    {
      "type": "http_status",
      "params": { "source": "client-01", "target": "api-01", "port": 8080, "path": "/health", "status": 200 },
      "description": "GET http://api-01:8080/health returns 200"
    }
  ],
  "solution_commands": [
    "ssh api-01",
    "docker run -d --name web -p 8080:80 nginx"
  ]
}
